datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  CLASS_ADMIN
  LECTURER
  ASSISTANT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TaskType {
  INDIVIDUAL
  GROUP
  ADDITIONAL
}

enum MaterialType {
  PDF
  PPT
  DOC
  XLS
  LINK
  VIDEO
  IMAGE
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  UPCOMING
  DUE_SOON
  COMPLETED
  SUBMITTED
  OVERDUE
}

enum AchievementCategory {
  COMPETITION
  VOLUNTEER
  ORGANIZATION
  ACADEMIC
  CREATIVE
  TECHNOLOGY
  OTHER
}

enum ResourceCategory {
  ACADEMIC
  CLASS
  REFERENCE
  IMPORTANT_LINK
  OTHER
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  role         UserRole     @default(ASSISTANT)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tasks         Task[]
  achievements  Achievement[]
  announcements Announcement[]
  gallery       Gallery[]
  resources     Resource[]
  materials     Material[]
  dailyNotes    DailyNote[]
  classEvents   ClassEvent[]
  activityLogs  ActivityLog[]

  @@map("users")
  @@index([email])
  @@index([role])
}

model Student {
  id            String    @id @default(cuid())
  name          String
  studentNumber String?   @unique @map("student_number")
  photoUrl      String?   @map("photo_url")
  bio           String?
  dream         String?
  motivation    String?
  major         String
  githubUrl     String?   @map("github_url")
  linkedinUrl   String?   @map("linkedin_url")
  portfolioUrl  String?   @map("portfolio_url")
  instagramUrl  String?   @map("instagram_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  achievements StudentAchievement[]

  @@map("students")
  @@index([name])
  @@index([major])
}

model Subject {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  englishName  String?    @map("english_name")
  description  String?
  sks          Int?       @default(3)
  lecturerName String?    @map("lecturer_name")
  semester     String?    @default("Semester Ganjil 2026/2027")
  academicYear String?    @default("2026/2027") @map("academic_year")
  color        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  schedules        Schedule[]
  tasks            Task[]
  materials        Material[]
  materialSections MaterialSection[]
  dailyNotes       DailyNote[]

  @@map("subjects")
}

model Schedule {
  id           String    @id @default(cuid())
  subjectId    String    @map("subject_id")
  dayOfWeek    DayOfWeek @map("day_of_week")
  startTime    String    @map("start_time")
  endTime      String    @map("end_time")
  room         String
  lecturerName String?   @map("lecturer_name")
  className    String?   @default("JS1SI-26-REG-05") @map("class_name")
  semester     String?   @default("Semester Ganjil 2026/2027")
  academicYear String?   @default("2026/2027") @map("academic_year")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@map("schedules")
  @@index([subjectId])
  @@index([dayOfWeek])
}

model Task {
  id            String       @id @default(cuid())
  subjectId     String?      @map("subject_id")
  title         String
  description   String?
  taskType      TaskType     @default(INDIVIDUAL) @map("task_type")
  deadline      DateTime
  estimatedTime String?      @map("estimated_time")
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(UPCOMING)
  groupName     String?      @map("group_name")
  groupMembers  String?      @map("group_members")
  attachmentUrl String?      @map("attachment_url")
  submissionUrl String?      @map("submission_url")
  referenceUrl  String?      @map("reference_url")
  notes         String?
  createdBy     String       @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  subject    Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  creator    User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  dailyNotes DailyNoteTask[]

  @@map("tasks")
  @@index([deadline])
  @@index([subjectId])
  @@index([status])
  @@index([taskType])
}

model MaterialSection {
  id          String   @id @default(cuid())
  subjectId   String   @map("subject_id")
  title       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  materials Material[]

  @@map("material_sections")
  @@index([subjectId])
  @@index([sortOrder])
}

model Material {
  id          String       @id @default(cuid())
  title       String
  description String?
  subjectId   String?      @map("subject_id")
  sectionId   String?      @map("section_id")
  type        MaterialType @default(PDF)
  fileUrl     String?      @map("file_url")
  externalUrl String?      @map("external_url")
  fileName    String?      @map("file_name")
  fileSize    String?      @map("file_size")
  tags        String?
  attachments String?
  uploadedBy  String       @map("uploaded_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  subject    Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  section    MaterialSection?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  uploader   User                @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  dailyNotes DailyNoteMaterial[]

  @@map("materials")
  @@index([subjectId])
  @@index([sectionId])
  @@index([type])
  @@index([createdAt])
}

model DailyNote {
  id              String   @id @default(cuid())
  date            DateTime
  title           String
  summary         String?
  content         String
  importantPoints String?  @map("important_points")
  nextSteps       String?  @map("next_steps")
  subjectId       String?  @map("subject_id")
  authorId        String   @map("author_id")
  tags            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subject   Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  author    User                @relation(fields: [authorId], references: [id], onDelete: Restrict)
  materials DailyNoteMaterial[]
  tasks     DailyNoteTask[]

  @@map("daily_notes")
  @@index([date])
  @@index([subjectId])
  @@index([authorId])
}

model DailyNoteMaterial {
  dailyNoteId String   @map("daily_note_id")
  materialId  String   @map("material_id")
  createdAt   DateTime @default(now()) @map("created_at")

  dailyNote DailyNote @relation(fields: [dailyNoteId], references: [id], onDelete: Cascade)
  material  Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([dailyNoteId, materialId])
  @@map("daily_note_materials")
}

model DailyNoteTask {
  dailyNoteId String   @map("daily_note_id")
  taskId      String   @map("task_id")
  createdAt   DateTime @default(now()) @map("created_at")

  dailyNote DailyNote @relation(fields: [dailyNoteId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([dailyNoteId, taskId])
  @@map("daily_note_tasks")
}

model Achievement {
  id              String              @id @default(cuid())
  title           String
  description     String?
  category        AchievementCategory
  achievementDate DateTime            @map("achievement_date")
  organization    String?
  location        String?
  badgeIconUrl    String?             @map("badge_icon_url")
  imageUrl        String?             @map("image_url")
  createdBy       String              @map("created_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  creator  User                 @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  students StudentAchievement[]

  @@map("achievements")
  @@index([category])
  @@index([achievementDate])
}

model StudentAchievement {
  studentId     String   @map("student_id")
  achievementId String   @map("achievement_id")
  createdAt     DateTime @default(now()) @map("created_at")

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([studentId, achievementId])
  @@map("student_achievements")
  @@index([studentId])
  @@index([achievementId])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  imageUrl    String?   @map("image_url")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("announcements")
  @@index([isPublished])
  @@index([publishedAt])
}

model Gallery {
  id          String    @id @default(cuid())
  title       String
  description String?
  imageUrl    String    @map("image_url")
  eventDate   DateTime? @map("event_date")
  uploadedBy  String    @map("uploaded_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@map("gallery")
  @@index([eventDate])
}

model Resource {
  id          String           @id @default(cuid())
  title       String
  description String?
  url         String
  category    ResourceCategory
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("resources")
  @@index([category])
}

model ClassEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime  @map("event_date")
  startTime   String?   @map("start_time")
  endTime     String?   @map("end_time")
  location    String?
  imageUrl    String?   @map("image_url")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("class_events")
  @@index([eventDate])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
  @@index([createdAt])
  @@index([entityType])
}
