# ==============================================================================
# ClassHub (WebKelas-2605) Environment Variables
# ==============================================================================

# 1. Database Configuration (Prisma ORM)
# Untuk Local Development menggunakan PGlite bawaan (port 5433):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/classhub?sslmode=disable&statement_cache_size=0"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/classhub?sslmode=disable"

# Untuk Production (Supabase / Neon / PostgreSQL Remote):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# 2. Authentication (jose JWT Session)
# Wajib minimal 32 karakter untuk enkripsi cookie session di /admin
AUTH_SECRET="development_super_secret_key_at_least_32_characters_long"

# 3. Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Storage & Supabase Integration (Opsional)
# Jika tidak diisi, sistem otomatis menyimpan file upload ke disk lokal (public/uploads/)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# 5. Database Seeding (Opsional)
# Password default akun admin saat seeding (default dev: AdminClassHub2026!)
# SEED_ADMIN_PASSWORD="AdminClassHub2026!"
